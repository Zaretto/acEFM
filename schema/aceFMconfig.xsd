      <xs:enumeration value="ED_FM_ENGINE_2_COMBUSTION"/>
      <xs:enumeration value="ED_FM_ENGINE_2_CORE_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_2_CORE_RELATED_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_2_CORE_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_2_CORE_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_2_FUEL_FLOW"/>
      <xs:enumeration value="ED_FM_ENGINE_2_OIL_PRESSURE"/>
      <xs:enumeration value="ED_FM_ENGINE_2_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_2_RELATED_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_2_RELATIVE_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_2_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_2_STARTER_CLUTCH_ENGAGED_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_2_STARTER_CLUTCH_ENGAGED_RELATED_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_2_STARTER_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_2_STARTER_RELATED_TORQUE"/>
