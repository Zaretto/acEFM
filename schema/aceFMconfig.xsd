      <xs:enumeration value="ED_FM_SUSPENSION_0_UP_LOCK"/>
      <xs:enumeration value="ED_FM_SUSPENSION_0_WHEEL_SELF_ATTITUDE"/>
      <xs:enumeration value="ED_FM_SUSPENSION_0_WHEEL_YAW"/>
      <xs:enumeration value="ED_FM_SUSPENSION_1_DOWN_LOCK"/>
      <xs:enumeration value="ED_FM_SUSPENSION_1_GEAR_POST_STATE"/>
      <xs:enumeration value="ED_FM_SUSPENSION_1_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_1_UP_LOCK"/>
      <xs:enumeration value="ED_FM_SUSPENSION_1_WHEEL_SELF_ATTITUDE"/>
      <xs:enumeration value="ED_FM_SUSPENSION_1_WHEEL_YAW"/>
      <xs:enumeration value="ED_FM_SUSPENSION_2_DOWN_LOCK"/>
      <xs:enumeration value="ED_FM_SUSPENSION_2_GEAR_POST_STATE"/>
      <xs:enumeration value="ED_FM_SUSPENSION_2_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_2_UP_LOCK"/>
      <xs:enumeration value="ED_FM_SUSPENSION_2_WHEEL_SELF_ATTITUDE"/>
      <xs:enumeration value="ED_FM_SUSPENSION_2_WHEEL_YAW"/>
      <xs:enumeration value="ED_FM_SUSPENSION_3_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_4_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_5_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_6_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_7_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_8_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_9_RELATIVE_BRAKE_MOMENT"/>
      <xs:enumeration value="ED_FM_SUSPENSION_10_RELATIVE_BRAKE_MOMENT"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- <index>: an ED_FM_* name or the raw integer index. -->
  <xs:simpleType name="edFmParamIndexT">
    <xs:union memberTypes="edFmParamNameT xs:nonNegativeInteger"/>
  </xs:simpleType>

  <!-- ===== the preset tree (everything outside <sim>) ===== -->

  <!-- One node of the FlightGear PropertyList format. Children of any name, nested to any depth.
       JSBSimToAnvil (ParsePresets) walks <fdm><jsbsim> and requires every leaf to be numeric or
       empty; acEFM loads the tree as initial property values. -->
  <xs:complexType name="presetNodeT" mixed="true">
    <xs:sequence>
      <xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="n" type="xs:nonNegativeInteger"/>
    <xs:attribute name="type">
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:enumeration value="bool"/>
          <xs:enumeration value="int"/>
          <xs:enumeration value="long"/>
          <xs:enumeration value="float"/>
          <xs:enumeration value="double"/>
          <xs:enumeration value="string"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="archive" type="ynT"/>
    <xs:attribute name="userarchive" type="ynT"/>
  </xs:complexType>

  <xs:simpleType name="ynT">
    <xs:restriction base="xs:token">
      <xs:enumeration value="y"/>
      <xs:enumeration value="n"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===== <sim> ===== -->

  <!-- <gauge>: JSBSim property -> DCS cockpit parameter (ed_cockpit_update_parameter_with_number).
       The <param> name is the display bus word AvionicsDisplay binds to. -->
  <xs:complexType name="gaugeT">
    <xs:all>
      <xs:element name="param" type="cockpitParamNameT"/>
      <xs:element name="property" type="propertyPathT"/>
      <xs:element name="factor" type="factorT" minOccurs="0"/>
      <xs:element name="delta" type="xs:double" minOccurs="0"/>
      <xs:element name="type" type="gaugeTypeT" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- <drawarg n="N">: JSBSim property -> external model draw argument N (ed_fm_set_draw_args).
       Written only when the value moves by more than <delta> (default 0.0001). -->
  <xs:complexType name="drawargT">
    <xs:all>
      <xs:element name="property" type="propertyPathT"/>
      <xs:element name="factor" type="xs:double" minOccurs="0"/>
      <xs:element name="offset" type="xs:double" minOccurs="0"/>
      <xs:element name="delta" type="xs:double" minOccurs="0"/>
    </xs:all>
    <xs:attribute name="n" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <!-- <command>: DCS input command -> JSBSim property (ed_fm_set_command). Identified by <name> (iCommand
       enum name) or <icommand> (raw code, used for aircraft-specific 10000+ codes); at least one.
       Write rule, in priority order:
         <toggle>  present: flip the property between 0 and the toggle value (default 1) once per press
         <value>   present: write that fixed value
         otherwise: out = clip(value * factor + offset, clip-min, clip-max)
       Repeating a code drives several properties. -->
  <xs:complexType name="commandT">
    <xs:sequence>
      <xs:choice>
        <xs:sequence>
          <xs:element name="name" type="iCommandNameT"/>
          <xs:element name="icommand" type="xs:nonNegativeInteger" minOccurs="0"/>
        </xs:sequence>
        <xs:sequence>
          <xs:element name="icommand" type="xs:nonNegativeInteger"/>
          <xs:element name="name" type="iCommandNameT" minOccurs="0"/>
        </xs:sequence>
      </xs:choice>
      <xs:element name="property" type="propertyPathT"/>
      <xs:element name="factor" type="factorT" minOccurs="0"/>
      <xs:element name="offset" type="xs:double" minOccurs="0"/>
      <xs:element name="clip-min" type="xs:double" minOccurs="0"/>
      <xs:element name="clip-max" type="xs:double" minOccurs="0"/>
      <xs:element name="value" type="xs:double" minOccurs="0"/>
      <xs:element name="toggle" type="xs:double" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- <param>: JSBSim property -> ed_fm_get_param index. XML entries take priority over acEFM's
       built-in engine and gear defaults (RegisterEngineDefaults / RegisterGearDefaults). -->
  <xs:complexType name="paramT">
    <xs:all>
      <xs:element name="index" type="edFmParamIndexT"/>
      <xs:element name="property" type="propertyPathT"/>
      <xs:element name="factor" type="xs:double" minOccurs="0"/>
      <xs:element name="offset" type="xs:double" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="simT">
    <xs:all>
      <!-- JSBSim aircraft root file name without .xml, under EFM/. Required by both readers. -->
      <xs:element name="aero" type="xs:token"/>
      <xs:element name="flight-model" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="jsb"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <!-- Engine count for the built-in ED_FM_ENGINE_n defaults; absent or 0 = Propulsion->GetNumEngines(). -->
      <xs:element name="engine-count" type="xs:nonNegativeInteger" minOccurs="0"/>
      <!-- Gear unit count for the built-in ED_FM_SUSPENSION_n defaults; absent = 3. -->
      <xs:element name="gear-count" type="xs:nonNegativeInteger" minOccurs="0"/>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="long-description" type="xs:string" minOccurs="0"/>
      <xs:element name="author" type="xs:string" minOccurs="0"/>
      <xs:element name="aircraft-version" type="xs:token" minOccurs="0"/>
      <xs:element name="status" type="xs:token" minOccurs="0"/>
      <xs:element name="current-view" type="presetNodeT" minOccurs="0"/>
      <!-- Named bindings: a leaf whose text is a property path. Only cabin-altitude-ft is read by acEFM
           (cabin pressurisation for ed_fm_get_param); JSBSimToAnvil captures every such leaf under <sim>. -->
      <xs:element name="ecs" minOccurs="0">
        <xs:complexType>
          <xs:all>
            <xs:element name="cabin-altitude-ft" type="propertyPathT" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="cockpit" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="gauge" type="gaugeT" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="animations" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="drawarg" type="drawargT" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- Without <commands> the aircraft has no throttle, flight controls or gear: acEFM has no built-in input bindings. -->
      <xs:element name="commands" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="command" type="commandT" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="params" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="param" type="paramT" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <!-- ===== root ===== -->

  <!-- Top-level sections. <sim> is the only one with a fixed shape; the others are preset subtrees.
       A new top-level section name is a schema change on purpose: the readers must know about it. -->
  <xs:element name="PropertyList">
    <xs:complexType>
      <xs:all>
        <xs:element name="sim" type="simT"/>
        <!-- JSBSim property presets: <fdm><jsbsim>path/to/property</jsbsim></fdm>, path built from element
             names with n="" becoming [n]. Empty leaf = declared, no initial value. -->
        <xs:element name="fdm" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="jsbsim" type="presetNodeT"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="gear" type="presetNodeT" minOccurs="0"/>
        <xs:element name="canopy" type="presetNodeT" minOccurs="0"/>
        <xs:element name="instrumentation" type="presetNodeT" minOccurs="0"/>
        <xs:element name="orientation" type="presetNodeT" minOccurs="0"/>
        <xs:element name="controls" type="presetNodeT" minOccurs="0"/>
        <xs:element name="engines" type="presetNodeT" minOccurs="0"/>
        <xs:element name="systems" type="presetNodeT" minOccurs="0"/>
        <xs:element name="environment" type="presetNodeT" minOccurs="0"/>
        <xs:element name="velocities" type="presetNodeT" minOccurs="0"/>
        <xs:element name="position" type="presetNodeT" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

</xs:schema>
