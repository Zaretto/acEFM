      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_2_RIGHT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_3_LEFT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_3_RIGHT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_4_LEFT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_4_RIGHT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_5_LEFT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_5_RIGHT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_6_LEFT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_6_RIGHT"/>
      <xs:enumeration value="ED_FM_FUEL_INTERNAL_FUEL"/>
      <xs:enumeration value="ED_FM_FUEL_LOW_SIGNAL"/>
      <xs:enumeration value="ED_FM_FUEL_TOTAL_FUEL"/>
      <xs:enumeration value="ED_FM_OXYGEN_SUPPLY"/>
      <xs:enumeration value="ED_FM_PISTON_ENGINE_0_MANIFOLD_PRESSURE"/>
      <xs:enumeration value="ED_FM_PISTON_ENGINE_1_MANIFOLD_PRESSURE"/>
      <xs:enumeration value="ED_FM_PISTON_ENGINE_2_MANIFOLD_PRESSURE"/>
      <xs:enumeration value="ED_FM_PROPELLER_0_INTEGRITY_FACTOR"/>
      <xs:enumeration value="ED_FM_PROPELLER_0_PITCH"/>
      <xs:enumeration value="ED_FM_PROPELLER_0_RPM"/>
      <xs:enumeration value="ED_FM_PROPELLER_0_TILT"/>
      <xs:enumeration value="ED_FM_PROPELLER_1_INTEGRITY_FACTOR"/>
      <xs:enumeration value="ED_FM_PROPELLER_1_PITCH"/>
      <xs:enumeration value="ED_FM_PROPELLER_1_RPM"/>
      <xs:enumeration value="ED_FM_PROPELLER_1_TILT"/>
      <xs:enumeration value="ED_FM_PROPELLER_2_INTEGRITY_FACTOR"/>
      <xs:enumeration value="ED_FM_PROPELLER_2_PITCH"/>
      <xs:enumeration value="ED_FM_PROPELLER_2_RPM"/>
      <xs:enumeration value="ED_FM_PROPELLER_2_TILT"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_CENTRAL_PITCH"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_CENTRAL_ROLL"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_FACTOR_PITCH"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_FACTOR_ROLL"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_SHAKE_AMPLITUDE_PITCH"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_SHAKE_AMPLITUDE_ROLL"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_SHAKE_FREQUENCY_PITCH"/>
      <xs:enumeration value="ED_FM_STICK_FORCE_SHAKE_FREQUENCY_ROLL"/>
      <xs:enumeration value="ED_FM_SUSPENSION_0_DOWN_LOCK"/>
      <xs:enumeration value="ED_FM_SUSPENSION_0_GEAR_POST_STATE"/>
