      <xs:enumeration value="ED_FM_ENGINE_1_STARTER_CLUTCH_ENGAGED_RELATED_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_1_STARTER_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_1_STARTER_RELATED_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_1_STARTER_SPIN_DOWN_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_1_STARTER_SPIN_DOWN_RELATED_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_1_TEMPERATURE"/>
      <xs:enumeration value="ED_FM_ENGINE_1_THRUST"/>
