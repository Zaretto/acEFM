      <xs:enumeration value="ED_FM_ENGINE_3_RPM"/>
      <xs:enumeration value="ED_FM_FC3_AR_DOOR_PROBE_HANDLE_POS"/>
      <xs:enumeration value="ED_FM_FC3_AUTOPILOT_FAILURE_ATTITUDE_STABILIZATION"/>
      <xs:enumeration value="ED_FM_FC3_AUTOPILOT_STATUS"/>
      <xs:enumeration value="ED_FM_FC3_BREAKE_CHUTE_STATUS"/>
      <xs:enumeration value="ED_FM_FC3_BREAKE_CHUTE_VALUE"/>
      <xs:enumeration value="ED_FM_FC3_CAS_FAILURE_PITCH_CHANNEL"/>
      <xs:enumeration value="ED_FM_FC3_CAS_FAILURE_ROLL_CHANNEL"/>
      <xs:enumeration value="ED_FM_FC3_CAS_FAILURE_YAW_CHANNEL"/>
      <xs:enumeration value="ED_FM_FC3_FLAPS_HANDLE_POS"/>
      <xs:enumeration value="ED_FM_FC3_GEAR_HANDLE_POS"/>
      <xs:enumeration value="ED_FM_FC3_PEDAL_L_LIMITER"/>
      <xs:enumeration value="ED_FM_FC3_PEDAL_R_LIMITER"/>
      <xs:enumeration value="ED_FM_FC3_RUDDER_PEDALS"/>
      <xs:enumeration value="ED_FM_FC3_SPEED_BRAKE_HANDLE_POS"/>
      <xs:enumeration value="ED_FM_FC3_STICK_PITCH"/>
      <xs:enumeration value="ED_FM_FC3_STICK_PITCH_LIMITER"/>
      <xs:enumeration value="ED_FM_FC3_STICK_ROLL"/>
      <xs:enumeration value="ED_FM_FC3_STICK_ROLL_L_LIMITER"/>
      <xs:enumeration value="ED_FM_FC3_THROTTLE_LEFT"/>
      <xs:enumeration value="ED_FM_FC3_THROTTLE_RIGHT"/>
      <xs:enumeration value="ED_FM_FC3_WHEEL_BRAKE_COMMAND_LEFT"/>
      <xs:enumeration value="ED_FM_FC3_WHEEL_BRAKE_COMMAND_RIGHT"/>
      <xs:enumeration value="ED_FM_FC3_WHEEL_BRAKE_LEFT"/>
      <xs:enumeration value="ED_FM_FC3_WHEEL_BRAKE_RIGHT"/>
      <xs:enumeration value="ED_FM_FLOW_VELOCITY"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_0_LEFT"/>
      <xs:enumeration value="ED_FM_FUEL_FUEL_TANK_GROUP_0_RIGHT"/>
