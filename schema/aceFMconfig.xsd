<?xml version="1.0" encoding="utf-8"?>
<!--
  aceFMconfig.xsd : schema for an acEFM aircraft configuration file (aceFMconfig.xml).

  The file is the single contract between the aircraft model and everything outside it.
  Four consumers read it and must agree on its shape:
    - acEFM.dll            flyt-EFM-dcsJSBSim/DCS_interface.cpp (run time: commands, params, drawargs, gauges)
    - JSBSimToAnvil        JSBSimToAnvil.Core/Parsing/AceFmConfigParser.cs (code generation for the Anvil FM)
    - AvionicsDisplay      feed map and "avdisplay check -map" (gauge param names = display bus words)
    - TestPlane            same reader as acEFM.dll
  Anything either reader needs that is not expressed here is a schema defect: fix the schema, not the file.

  Two kinds of content:
    1. <sim>          strict. Every element is enumerated and typed below.
    2. everything else  a FlightGear-style property preset tree (PropertyList format). Element names are
                        property names, n="" is the array index, the text is the initial value. The names are
                        open because they ARE the property tree; the attribute vocabulary (n, type, archive,
                        userarchive) is checked on the section element only, not on nested nodes (XSD 1.0
                        cannot type the children of an open wildcard).

  Property path text (gauge, drawarg, command, param, sim/ecs): "/fdm/jsbsim/x/y[0]" or "fdm/jsbsim/x/y";
  both readers strip the leading slash and the fdm/jsbsim/ prefix.

  Validate: xmllint -noout -schema aceFMconfig.xsd aceFMconfig.xml
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ===== simple types ===== -->

  <!-- A JSBSim property path, optionally rooted at /fdm/jsbsim. Segments: letters, digits, _ - . with an
       optional [n] index. No whitespace. -->
  <xs:simpleType name="propertyPathT">
    <xs:restriction base="xs:token">
      <xs:pattern value="/?[A-Za-z0-9_\-\.]+(\[[0-9]+\])?(/[A-Za-z0-9_\-\.]+(\[[0-9]+\])?)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Named conversion factors resolved by acEFM's conversion_map (DCS_interface.cpp). -->
  <xs:simpleType name="conversionNameT">
    <xs:restriction base="xs:token">
      <xs:enumeration value="METER_TO_FEET"/>
      <xs:enumeration value="FEET_TO_METER"/>
      <xs:enumeration value="DEGREES_TO_RADIANS"/>
      <xs:enumeration value="RADIANS_TO_DEGREES"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- <factor>: a number or one of the conversion names. -->
  <xs:simpleType name="factorT">
    <xs:union memberTypes="xs:double conversionNameT"/>
  </xs:simpleType>

  <!-- A DCS cockpit parameter name as passed to ed_cockpit_get_parameter_handle and read by
       get_param_handle in cockpit Lua. -->
  <xs:simpleType name="cockpitParamNameT">
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A DCS iCommand name from flyt-EFM-dcsJSBSim/iCommands.h (generated from iCommands.lua; 3500+ names,
       so a pattern rather than an enumeration). Resolved by DCS::iCommandFromName at load. -->
  <xs:simpleType name="iCommandNameT">
    <xs:restriction base="xs:token">
      <xs:pattern value="iCommand[A-Za-z0-9_]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Gauge actuator type (DCS_interface.h CockpitItem::ActuatorType). Absent = direct value. -->
  <xs:simpleType name="gaugeTypeT">
    <xs:restriction base="xs:token">
      <xs:enumeration value="GenevaDrive"/>
      <xs:enumeration value="LinearDrive"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ed_fm_get_param indices acEFM can route from XML: the enumMap in DCS_interface.h. A raw integer is
       also accepted by the reader; prefer the name. -->
  <xs:simpleType name="edFmParamNameT">
    <xs:restriction base="xs:token">
      <xs:enumeration value="ED_FM_ANTI_SKID_ENABLE"/>
      <xs:enumeration value="ED_FM_CAN_ACCEPT_FUEL_FROM_TANKER"/>
      <xs:enumeration value="ED_FM_COCKPIT_ALTIMETER_PRESSURE_SETTING_MM_HG"/>
      <xs:enumeration value="ED_FM_COCKPIT_PRESSURIZATION_OVER_EXTERNAL"/>
      <xs:enumeration value="ED_FM_ENGINE_0_COMBUSTION"/>
      <xs:enumeration value="ED_FM_ENGINE_0_CORE_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_0_CORE_RELATED_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_0_CORE_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_0_CORE_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_0_FUEL_FLOW"/>
      <xs:enumeration value="ED_FM_ENGINE_0_OIL_PRESSURE"/>
      <xs:enumeration value="ED_FM_ENGINE_0_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_0_RELATED_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_0_RELATIVE_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_0_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_0_STARTER_CLUTCH_ENGAGED_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_0_STARTER_CLUTCH_ENGAGED_RELATED_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_0_STARTER_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_0_STARTER_RELATED_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_0_STARTER_SPIN_DOWN_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_0_STARTER_SPIN_DOWN_RELATED_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_0_TEMPERATURE"/>
      <xs:enumeration value="ED_FM_ENGINE_0_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_0_TORQUE"/>
      <xs:enumeration value="ED_FM_ENGINE_1_COMBUSTION"/>
      <xs:enumeration value="ED_FM_ENGINE_1_CORE_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_1_CORE_RELATED_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_1_CORE_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_1_CORE_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_1_FUEL_FLOW"/>
      <xs:enumeration value="ED_FM_ENGINE_1_OIL_PRESSURE"/>
      <xs:enumeration value="ED_FM_ENGINE_1_RELATED_RPM"/>
      <xs:enumeration value="ED_FM_ENGINE_1_RELATED_THRUST"/>
      <xs:enumeration value="ED_FM_ENGINE_1_RELATIVE_TORQUE"/>
